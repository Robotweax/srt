  "findings": [
    {
      "status": "observed",
      "finding": "All four full-workload diagnostic transfers completed with exact payloads in 57.8\u2013111.0 seconds. This demonstrates eventual completion in these cases, not reliable completion within the failed 60-second gate.",
      "limits": "Only two full transfers per version, with different sampling; no statistical equivalence or absence-of-regression claim."
    },
    {
      "status": "observed",
      "finding": "Jitter without netem drops produced about 19.5k/21.5k retransmissions and about 21.7/21.6 seconds completion for candidate/baseline; clean controls completed in about 3 seconds. One short 32-stream candidate run still timed out; a queued connection was continuing at a small congestion window and 12\u201317ms packet spacing.",
      "interpretation": "Evidence points to low FileCC pacing rates and sensitivity to reordered/early-loss feedback, rather than a frozen receiver in these captured cases."
    },
    {
      "status": "confirmed code-path defect, present in both versions",
      "finding": "File setup clears live_options_, including retransmit_flag. Receive-side reorder recognition and Fresh-Loss aging are gated by that flag. Setting SRTO_LOSSMAXTTL=64 cannot enable the adaptive path in File mode.",
      "network_observation": "Both File peers retained zero reorder distance/tolerance at bounds 0 and 64 under jitter.",
      "deterministic_reproducer": "With configured bound 64 and packet arrivals 12,10,11,15, Live with retransmit capability records tolerance/distance 2 and defers the second gap report; File records zero and reports the gap immediately. Identical on both frozen libraries.",
