prefix=@ROBOTWEAX_SRT_PC_PREFIX@
exec_prefix=${prefix}
libdir=@ROBOTWEAX_SRT_PC_LIBDIR@
includedir=@ROBOTWEAX_SRT_PC_INCLUDEDIR@
robotweax_release=@PROJECT_VERSION@
robotweax_abi=@ROBOTWEAX_SRT_ABI_VERSION@

Name: Robotweax SRT libsrt compatibility
Description: Opt-in libsrt-compatible metadata for FFmpeg and similar consumers
Version: @ROBOTWEAX_SRT_COMPATIBLE_SRT_VERSION@
Requires.private: libcrypto >= 3.0
Libs: -L${libdir} -l@ROBOTWEAX_SRT_LIBRARY_NAME@
Libs.private: @ROBOTWEAX_SRT_PC_PRIVATE_LIBS@
Cflags: -I${includedir} @ROBOTWEAX_SRT_PC_CFLAGS@
