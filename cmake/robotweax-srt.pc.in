prefix=@ROBOTWEAX_SRT_PC_PREFIX@
exec_prefix=${prefix}
libdir=@ROBOTWEAX_SRT_PC_LIBDIR@
includedir=@ROBOTWEAX_SRT_PC_INCLUDEDIR@

Name: Robotweax SRT
Description: Independent Secure Reliable Transport implementation
Version: @PROJECT_VERSION@
Requires.private: @ROBOTWEAX_SRT_PC_CRYPTO_REQUIRES@
Libs: -L${libdir} -l@ROBOTWEAX_SRT_LIBRARY_NAME@@ROBOTWEAX_SRT_PC_LINK_OPTIONS@
Libs.private: @ROBOTWEAX_SRT_PC_PRIVATE_LIBS@
Cflags: -I${includedir} @ROBOTWEAX_SRT_PC_CFLAGS@
